VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Optional first-admin bootstrap. Chevvy never ships a known default password:
# set these before the first browser load, then remove the password from .env.
# Leave unset for a clean install with no admin account.
VITE_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# VITE_ADMIN_BOOTSTRAP_PASSWORD=choose-a-long-unique-password

# ---------------------------------------------------------------------------
# Deployment settings (Docker / docker compose) — placeholders only.
# Copy this file to .env and replace placeholders locally; never commit .env.
# ---------------------------------------------------------------------------
# Host port mapped to nginx port 80 inside the container.
HOST_PORT=8080
# Local image tag produced by `docker compose build`.
CHEVVY_IMAGE=chevvy:latest
